% Folder containing the separated .mat files
clc; clear;

% Configuration
DATA_FOLDER      = pwd;
data_types       = {'TRAINING'};
duplicate_policy = 'keep_first';

% Merge each data type
for d = 1:numel(data_types)

    dtype    = data_types{d};
    varname  = ['DATA_' dtype];
    out_path = fullfile(DATA_FOLDER, [varname '_UNIFIED.mat']);

    fprintf('\nMerging %s...\n', varname);

    % Find input files
    files      = dir(fullfile(DATA_FOLDER, [varname '*.mat']));
    file_names = {files.name};
    exclude    = contains(file_names, '_UNIFIED') | ...
                 contains(file_names, '_MERGED')  | ...
                 contains(file_names, '_ALL');
    files      = files(~exclude);

    if isempty(files)
        warning('No files found for %s', varname);
        continue
    end

    files = sort_files_by_suffix(files, varname);
    fprintf('  Found %d files to merge.\n', numel(files));

    % Pass 1 - Collect subject IDs and their location (file + index)
    fprintf('\n  Pass 1: collecting subject IDs...\n');

    id_list       = {};   % cell array of IDs
    file_idx_list = [];   % which file each subject comes from
    arr_idx_list  = [];   % index within that file subjects array

    for f = 1:numel(files)

        file_path = fullfile(files(f).folder, files(f).name);
        fprintf('    Reading IDs from %s\n', files(f).name);

        S = load(file_path, varname);

        if ~isfield(S, varname)
            warning('File %s does not contain %s. Skipping.', files(f).name, varname);
            clear S
            continue
        end

        D = S.(varname);
        clear S

        if ~isfield(D, 'subjects') || isempty(D.subjects)
            warning('No subjects found in %s. Skipping.', files(f).name);
            clear D
            continue
        end

        n_subj = numel(D.subjects);

        for k = 1:n_subj
            id_list{end+1}      = D.subjects(k).id;   %#ok<SAGROW>
            file_idx_list(end+1) = f;                  %#ok<SAGROW>
            arr_idx_list(end+1)  = k;                  %#ok<SAGROW>
        end

        clear D
        fprintf('    Found %d subjects.\n', n_subj);

    end

    fprintf('  Total subjects collected: %d\n', numel(id_list));

    % Handle duplicates (on IDs only, no heavy data)
    [id_list, file_idx_list, arr_idx_list] = ...
        handle_duplicate_index(id_list, file_idx_list, arr_idx_list, duplicate_policy);

    % Sort by subject ID
    [id_list, file_idx_list, arr_idx_list] = ...
        sort_index_by_id(id_list, file_idx_list, arr_idx_list);

    fprintf('  Subjects after dedup + sort: %d\n', numel(id_list));

    % Pass 2 - Write subjects one by one into output file
    fprintf('\n  Pass 2: writing subjects to output file...\n');

    n_total = numel(id_list);

    % Pre-allocate a cell array on disk via matfile
    % We store subjects as a cell array in the unified file
    out             = matfile(out_path, 'Writable', true);
    out.subjects_cell = cell(1, n_total);

    current_file_idx = -1;
    current_subjects = [];

    for k = 1:n_total

        fi = file_idx_list(k);
        ai = arr_idx_list(k);

        % Load new source file only when file index changes
        if fi ~= current_file_idx

            fprintf('    Loading source file %d / %d : %s\n', ...
                    fi, numel(files), files(fi).name);

            file_path = fullfile(files(fi).folder, files(fi).name);
            S = load(file_path, varname);
            current_subjects = S.(varname).subjects;
            current_file_idx = fi;
            clear S

        end

        % Write single subject into the output file
        out.subjects_cell(1, k) = {current_subjects(ai)};

        if mod(k, 10) == 0 || k == n_total
            fprintf('    Written %d / %d subjects\n', k, n_total);
        end

    end

    clear current_subjects

    % Reconstruct unified struct from the cell array on disk
    fprintf('\n  Rebuilding unified struct from cell array...\n');

    subjects_cell    = out.subjects_cell;         % load cell array
    unified_subjects = [subjects_cell{:}];        % cell -> struct array
    clear subjects_cell

    DATA_UNIFIED.subjects = unified_subjects;     %#ok<NASGU>
    clear unified_subjects

    fprintf('  Saving final unified struct to %s\n', out_path);
    save(out_path, 'DATA_UNIFIED', '-v7.3');

    fprintf('  Done. Total subjects saved: %d\n', numel(DATA_UNIFIED.subjects));
    clear DATA_UNIFIED

end

% Save final unified structs
%save(fullfile(DATA_FOLDER, 'DATA_BASELINE_UNIFIED.mat'), 'DATA_BASELINE', '-v7.3');
% save(fullfile(DATA_FOLDER, 'DATA_TEST_UNIFIED.mat'),     'DATA_TEST',     '-v7.3');
% save(fullfile(DATA_FOLDER, 'DATA_REST_UNIFIED.mat'),     'DATA_REST',     '-v7.3');
 save(fullfile(DATA_FOLDER, 'DATA_TRAINING_UNIFIED.mat'), 'DATA_TRAINING', '-v7.3');
% 
% % Optional: save all 4 structs together in one file
% save(fullfile(DATA_FOLDER, 'DATA_ALL_4_STRUCTS_UNIFIED.mat'), ...
%     'DATA_BASELINE', 'DATA_TEST', 'DATA_REST', 'DATA_TRAINING', '-v7.3');
% 
% fprintf('\nDONE. Unified structs saved.\n');


function write_subjects_incrementally(subject_index, files, varname, out_path)
%WRITE_SUBJECTS_INCREMENTALLY
% Loads one subject at a time and appends to the output .mat (v7.3).
% RAM footprint = one subject at a time + one loaded file at a time.

    n = numel(subject_index);

    % Cache: keep one source file open at a time to avoid re-loading
    current_file_idx  = -1;
    current_subjects  = [];

    % We cannot index into a struct array field with matfile directly,
    % but we CAN store subjects as a cell array, which matfile supports
    % for row-by-row writing with v7.3.

    % Initialise output file with an empty cell
    out = matfile(out_path, 'Writable', true);

    % Write a placeholder so the variable exists and is a cell
    % (matfile needs the variable to exist before indexing)
    out.(varname) = struct('subjects', {cell(1, n)});
    % Note: struct + cell inside matfile has limits.
    % Simpler: save subjects as a plain cell in the unified file.

    % ---- Simpler flat approach: save as subjects_cell{k} ----
    % Then reassemble into struct when actually needed.

    out.subjects_cell = cell(1, n);   % pre-allocate in file

    for k = 1:n

        fi = subject_index(k).file_idx;
        ai = subject_index(k).array_idx;

        % Load source file only when it changes
        if fi ~= current_file_idx
            fprintf('    Loading source file %d/%d\n', fi, numel(files));
            file_path = fullfile(files(fi).folder, files(fi).name);
            S = load(file_path, varname);
            current_subjects  = S.(varname).subjects;
            current_file_idx  = fi;
            clear S
        end

        % Write single subject into the output file
        out.subjects_cell(1, k) = {current_subjects(ai)};

        if mod(k, 10) == 0
            fprintf('    Written %d / %d subjects\n', k, n);
        end

    end

    clear current_subjects

    fprintf('  All subjects written. Rebuilding unified struct...\n');

    % Reload cell and convert to struct array (only struct array, no raw data)
    % This is the one moment where subjects_cell is fully in RAM.
    % Each element is one subject struct -- usually small metadata.
    cells = out.subjects_cell;           % loads cell array (just structs/pointers)
    unified_subjects = [cells{:}];       % convert cell -> struct array

    % Save the proper struct
    FINAL.subjects = unified_subjects;
    save(out_path, '-struct', 'FINAL', '-v7.3');

    fprintf('  Unified struct saved to %s\n', out_path);

end
%% Folder containing the separated .mat files
DATA_FOLDER = pwd;   % change if needed, e.g. '/path/to/mat/files'

% What to merge
data_types = {'TRAINING'};%;, 'TEST', 'REST', 'TRAINING'};

% What to do if the same subject appears in more than one file:
% 'error'      -> stop and show duplicate subject IDs
% 'keep_first' -> keep first occurrence
% 'keep_last'  -> keep last occurrence
duplicate_policy = 'keep_first';

% Merge each data type
for d = 1:numel(data_types)

    dtype = data_types{d};
    varname = ['DATA_' dtype];

    fprintf('\nMerging %s...\n', varname);

    % Find files like DATA_BASELINE_*.mat, DATA_TEST_*.mat, etc.
    files = dir(fullfile(DATA_FOLDER, [varname '*.mat']));

    % Exclude previously merged files if present
    file_names = {files.name};
    exclude = contains(file_names, '_UNIFIED') | ...
              contains(file_names, '_MERGED')  | ...
              contains(file_names, '_ALL');

    files = files(~exclude);

    if isempty(files)
        warning('No files found for %s', varname);
        eval([varname ' = struct();']);
        continue
    end

    % Sort files by numeric suffix if possible
    files = sort_files_by_suffix(files, varname);

    all_subjects = [];

    for f = 1:numel(files)

        file_path = fullfile(files(f).folder, files(f).name);
        fprintf('  Loading %s\n', files(f).name);

        S = load(file_path);

        if ~isfield(S, varname)
            warning('File %s does not contain variable %s. Skipping.', files(f).name, varname);
            continue
        end

        D = S.(varname);

        if ~isfield(D, 'subjects')
            warning('%s in file %s has no field "subjects". Skipping.', varname, files(f).name);
            continue
        end

        subjects_to_add = D.subjects;

        if isempty(subjects_to_add)
            continue
        end

        all_subjects = concatenate_subjects(all_subjects, subjects_to_add);

    end

    % Check duplicates
    all_subjects = handle_duplicate_subjects(all_subjects, duplicate_policy);

    % Sort by subject number: s02N, s05N, ..., s47H
    all_subjects = sort_subjects_by_id(all_subjects);

    % Create final struct
    FINAL = struct();
    FINAL.subjects = all_subjects;

    % Put final struct in workspace with correct name
    eval([varname ' = FINAL;']);

    fprintf('  Final number of subjects in %s: %d\n', varname, numel(FINAL.subjects));

end

% Save final unified structs
save(fullfile(DATA_FOLDER, 'DATA_BASELINE_UNIFIED.mat'), 'DATA_BASELINE', '-v7.3');
% save(fullfile(DATA_FOLDER, 'DATA_TEST_UNIFIED.mat'),     'DATA_TEST',     '-v7.3');
% save(fullfile(DATA_FOLDER, 'DATA_REST_UNIFIED.mat'),     'DATA_REST',     '-v7.3');
% save(fullfile(DATA_FOLDER, 'DATA_TRAINING_UNIFIED.mat'), 'DATA_TRAINING', '-v7.3');
% 
% % Optional: save all 4 structs together in one file
% save(fullfile(DATA_FOLDER, 'DATA_ALL_4_STRUCTS_UNIFIED.mat'), ...
%     'DATA_BASELINE', 'DATA_TEST', 'DATA_REST', 'DATA_TRAINING', '-v7.3');
% 
% fprintf('\nDONE. Unified structs saved.\n');


% Local functions

function out = concatenate_subjects(a, b)

    if isempty(a)
        out = b;
        return
    end

    if isempty(b)
        out = a;
        return
    end

    % Make sure both struct arrays have the same top-level fields
    fields_a = fieldnames(a);
    fields_b = fieldnames(b);

    all_fields = unique([fields_a; fields_b], 'stable');

    a = add_missing_fields(a, all_fields);
    b = add_missing_fields(b, all_fields);

    a = orderfields(a, all_fields);
    b = orderfields(b, all_fields);

    % Concatenate as row vector
    out = [a(:); b(:)].';

end


function S = add_missing_fields(S, all_fields)

    current_fields = fieldnames(S);

    for i = 1:numel(all_fields)

        fname = all_fields{i};

        if ~ismember(fname, current_fields)
            [S.(fname)] = deal([]);
        end

    end

end

function [ids, file_idx, arr_idx] = handle_duplicate_index(ids, file_idx, arr_idx, policy)

    if isempty(ids)
        return
    end

    [~, ~, ic] = unique(ids, 'stable');
    counts     = accumarray(ic(:), 1);
    has_dup    = counts(ic) > 1;

    if ~any(has_dup)
        return
    end

    dup_ids = unique(ids(has_dup), 'stable');
    fprintf('\n  Duplicate subject IDs found:\n');
    disp(dup_ids(:));

    switch policy

        case 'error'
            error(['Duplicate subjects found. ','Set duplicate_policy to ''keep_first'' or ''keep_last''.']);

        case 'keep_first'
            [~, keep] = unique(ids, 'stable');
            keep      = sort(keep);
            ids       = ids(keep);
            file_idx  = file_idx(keep);
            arr_idx   = arr_idx(keep);

        case 'keep_last'
            [~, keep] = unique(fliplr(ids), 'stable');
            keep      = numel(ids) - keep + 1;
            keep      = sort(keep);
            ids       = ids(keep);
            file_idx  = file_idx(keep);
            arr_idx   = arr_idx(keep);

        otherwise
            error('Unknown duplicate_policy: %s', policy);

    end

end
% function S = handle_duplicate_subjects(S, duplicate_policy)
% 
%     if isempty(S) || ~isfield(S, 'id')
%         return
%     end
% 
%     ids = {S.id};
% 
%     [unique_ids, ~, idx] = unique(ids, 'stable');
%     counts = accumarray(idx(:), 1);
% 
%     duplicate_ids = unique_ids(counts > 1);
% 
%     if isempty(duplicate_ids)
%         return
%     end
% 
%     fprintf('\nDuplicate subject IDs found:\n');
%     disp(duplicate_ids(:));
% 
%     switch duplicate_policy
% 
%         case 'error'
% 
%             error(['Duplicate subjects found. ', ...
%                    'Check your input files or set duplicate_policy to ', ...
%                    '''keep_first'' or ''keep_last''.']);
% 
%         case 'keep_first'
% 
%             [~, keep_idx] = unique(ids, 'stable');
%             keep_idx = sort(keep_idx);
%             S = S(keep_idx);
% 
%         case 'keep_last'
% 
%             [~, reversed_idx] = unique(fliplr(ids), 'stable');
%             keep_idx = numel(ids) - reversed_idx + 1;
%             keep_idx = sort(keep_idx);
%             S = S(keep_idx);
% 
%         otherwise
% 
%             error('Unknown duplicate_policy: %s', duplicate_policy);
% 
%     end
% 
% end


function S = sort_subjects_by_id(S)

    if isempty(S) || ~isfield(S, 'id')
        return
    end

    ids = {S.id};
    subj_nums = nan(numel(ids), 1);

    for i = 1:numel(ids)

        token = regexp(ids{i}, '^s(\d+)', 'tokens', 'once');

        if ~isempty(token)
            subj_nums(i) = str2double(token{1});
        else
            subj_nums(i) = inf;
        end

    end

    [~, order] = sort(subj_nums);
    S = S(order);

end


function files_sorted = sort_files_by_suffix(files, varname)

    nums = nan(numel(files), 1);

    for i = 1:numel(files)

        % Example: DATA_BASELINE_47.mat -> 47
        expr = ['^' regexptranslate('escape', varname) '_(\d+)\.mat$'];
        token = regexp(files(i).name, expr, 'tokens', 'once');

        if ~isempty(token)
            nums(i) = str2double(token{1});
        else
            nums(i) = inf;
        end

    end

    [~, order] = sort(nums);
    files_sorted = files(order);

end